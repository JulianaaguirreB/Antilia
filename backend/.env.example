# Copia este archivo a .env y completa los valores

# Cadena de conexión a PostgreSQL
# Local con docker-compose: postgresql://logtech:logtech@localhost:5432/logtech
# Supabase/Neon/Render: la cadena que te da el proveedor (incluye ?sslmode=require)
DATABASE_URL=postgresql://logtech:logtech@localhost:5432/logtech

# Cualquier texto largo y secreto, no lo subas real a GitHub
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto donde corre el servidor
PORT=3000

# DATABASE_SSL=true # Activa SSL con verificación de certificado
# DATABASE_SSL_REJECT_UNAUTHORIZED=false # Desactiva la verificación del certificado SSL

RESEND_API_KEY=
REMINDER_FROM=
CRON_SECRET=
